# Copy to .env.local (git-ignored). Local values: run `supabase status`.
# Only public values here: the publishable key is safe in the browser, RLS protects the data.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:55321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Integration tests only (never used by the app, never prefixed NEXT_PUBLIC_).
# Optional locally: auto-detected with `supabase status`. Required in CI.
# SUPABASE_URL=http://127.0.0.1:55321
# SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# SUPABASE_SECRET_KEY=sb_secret_xxx
